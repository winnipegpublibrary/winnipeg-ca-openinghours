name: Update library hours schema

on:
  schedule:
    - cron: "0 12 * * *"   # daily at 12:00 UTC (7am Winnipeg standard time) -- adjust as needed
  workflow_dispatch: {}     # adds a "Run workflow" button in the Actions tab, for manual testing

permissions:
  contents: write   # needed so this workflow can commit its own changes back to the repo

jobs:
  update-hours:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install requests

      - name: Fetch hours and build schema files
        run: python get_hours_schema.py

      - name: Commit and push if changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add hours-schema/
          git diff --staged --quiet || git commit -m "Update hours schema files"
          git push
