def to_24h(text):
    """Convert LibCal's '8am' / '5:30pm' style times to 24h 'HH:MM'."""
    text = text.strip().lower().replace(" ", "")
    is_pm = text.endswith("pm")
    text = text[:-2]
    if ":" in text:
        hour_str, minute = text.split(":")
    else:
        hour_str, minute = text, "00"
    hour = int(hour_str)
    if is_pm and hour != 12:
        hour += 12
    if not is_pm and hour == 12:
        hour = 0
    return f"{hour:02d}:{minute}"


def build_schema(location_data):
    """Turn one location's day-by-day hours into OpeningHoursSpecification entries."""
    spec = []
    for date_str, day_info in location_data.get("dates", {}).items():
        if day_info.get("status") != "open":
            continue
        day_name = datetime.date.fromisoformat(date_str).strftime("%A")
        for block in day_info.get("hours", []):
            spec.append({
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": f"https://schema.org/{day_name}",
                "opens": to_24h(block["from"]),
                "closes": to_24h(block["to"]),
            })
    return spec


